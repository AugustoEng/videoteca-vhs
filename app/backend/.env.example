# Servidor HTTP
PORT=3001
HOST=127.0.0.1
# Gerar um segredo novo e forte; NUNCA enviar ao GitHub.
AUTH_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
# Apenas se o front-end rodar em origem diferente, exemplo http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Adaptador MySQL usado pelo servidor; ver CONTRATO_REPOSITORIO.md
REPOSITORIO_MODULE=./repositorios/mysql-repository
# Configuração de conexão do adaptador, SEM root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=videoteca
DB_USER=app_videoteca
DB_PASSWORD=
